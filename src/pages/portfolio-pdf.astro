---
import type { ImageMetadata } from "astro";
import { getEntry } from "astro:content";
import { getImage } from "astro:assets";
import { Icon } from "astro-icon/components";
import * as yaml from "js-yaml";
import QRCode from "qrcode";
import config from "../config.mjs";
import { getSortedProjects } from "../utils/projects";
import { getCvExperiences, getCvEducations } from "../utils/cv";
import { limitConcurrency } from "../utils/async";
import { sanitizeUrl } from "../utils/security";

// Page hors navigation : mise en page A4 paysage destinée à l'export PDF
// interactif via `bun run pdf` (scripts/generate-portfolio-pdf.mjs). Elle est
// exclue du sitemap (astro.config.mjs) et marquée noindex ci-dessous.

interface PdfSectionConfig {
  title: string;
  description: string;
  projects: Array<{ id: string; note: string }>;
}

interface PdfCoverSpecimen {
  image: string;
  label: string;
  source: string;
}

interface PdfCoverConfig {
  lead: string[];
  display: string[];
  specimens: PdfCoverSpecimen[];
  savoirFaire: string[];
  logiciels: string[];
  route: { from: string; to: string };
}

interface PdfConfig {
  subtitle: string;
  edition: string;
  cover: PdfCoverConfig;
  portrait: string;
  mobility: { title: string; short: string; note: string };
  intro: string;
  imageFocus?: Record<string, "left" | "right" | "top" | "contain" | "plain">;
  tools: string[];
  sections: PdfSectionConfig[];
}

interface CVBasics {
  personal: {
    name: string;
    title: string;
    badge: string;
    location: string;
    email: string;
    linkedin: string;
    linkedinUrl: string;
    portfolio: string;
    portfolioUrl: string;
  };
  profile: { title: string; content: string };
  skills: {
    title: string;
    items: Array<{ category: string; description: string }>;
  };
  awards: { title: string; items: string[] };
  languages: Array<{ name: string; level: string }>;
}

const rawYaml = import.meta.glob("../data/*.yml", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;

const pdfConfig = yaml.load(rawYaml["../data/portfolio-pdf.yml"]) as PdfConfig;
const cvBasics = (
  yaml.load(rawYaml["../data/cv-basics.yml"]) as Record<string, CVBasics>
).fr;

const author = await getEntry("author", "samuel");
if (!author) throw new Error("Auteur `samuel` introuvable.");

// Sélection éditoriale : les chapitres de portfolio-pdf.yml présentent leurs
// projets en pleine page ; les autres alimentent la grille compacte, triés
// par poids éditorial.
const allProjects = await getSortedProjects();

type Project = (typeof allProjects)[number];

const projectsById = new Map(allProjects.map((p) => [p.id, p]));
const sections = pdfConfig.sections.map((section) => ({
  ...section,
  entries: section.projects.map(({ id }) => {
    const entry = projectsById.get(id);
    if (!entry)
      throw new Error(`Projet inconnu dans portfolio-pdf.yml : « ${id} »`);
    return entry;
  }),
}));
const noteById = new Map(
  pdfConfig.sections.flatMap((s) => s.projects.map((p) => [p.id, p.note])),
);
const featured = sections.flatMap((s) => s.entries);
const featuredIds = new Set(featured.map((p) => p.id));
const others = allProjects
  .filter((p) => !featuredIds.has(p.id))
  .sort(
    (a, b) =>
      b.data.featured - a.data.featured ||
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

// Parcours (CV condensé)
const experiences = (await getCvExperiences())
  .filter((exp) => exp.data.lang === "fr" && !exp.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
const educations = (await getCvEducations())
  .filter((edu) => edu.data.lang === "fr" && !edu.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

// Images optimisées (concurrence bornée : mêmes précautions que le build).
// Les photos passent en JPEG : Chromium embarque les flux JPEG tels quels
// dans le PDF, alors que les WebP y sont ré-encodés en bitmaps beaucoup plus
// lourds. Les captures d'interface passent en PNG sans perte : le chroma
// 4:2:0 du JPEG fait baver les aplats et les éléments colorés des UI.
const imageFocus = pdfConfig.imageFocus ?? {};
const isContain = (p: Project) =>
  imageFocus[p.id] === "contain" || imageFocus[p.id] === "plain";
const isUiThumb = (p: Project) => isContain(p) || p.data.category === "web";

async function imagesById(
  entries: Project[],
  width: number,
  quality: number,
  pngWhen: (p: Project) => boolean,
) {
  const images = await limitConcurrency(entries, 2, async (p) =>
    p.data.image
      ? getImage(
          pngWhen(p)
            ? { src: p.data.image, width, format: "png" }
            : { src: p.data.image, width, format: "jpg", quality },
        )
      : null,
  );
  return new Map(entries.map((p, i) => [p.id, images[i]]));
}

const coverById = await imagesById(featured, 1200, 74, isContain);
const thumbById = await imagesById(featured, 300, 68, isUiThumb);
const otherThumbById = await imagesById(others, 460, 68, isUiThumb);
// Spécimens de la couverture : images déjà tramées (trait sur fond
// transparent), donc PNG et aucune reconversion — le chroma JPEG détruirait
// les points d'impression.
const specimenModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/portfolio-pdf/*.png",
);
const coverSpecimens = await Promise.all(
  pdfConfig.cover.specimens.map(async (spec) => {
    const loader = specimenModules[`../assets/portfolio-pdf/${spec.image}`];
    if (!loader)
      throw new Error(
        `Spécimen de couverture introuvable dans src/assets/portfolio-pdf/ : « ${spec.image} »`,
      );
    return { ...spec, src: (await loader()).default.src };
  }),
);
// Portrait de la page Profil, choisi dans src/assets/ via portfolio-pdf.yml
// (la photo de la fiche auteur n'est pas un portrait posé).
const portraitModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/*.{avif,webp,png,jpg}",
);
const portraitLoader = portraitModules[`../assets/${pdfConfig.portrait}`];
if (!portraitLoader)
  throw new Error(
    `Portrait introuvable dans src/assets/ : « ${pdfConfig.portrait} »`,
  );
const authorPhoto = await getImage({
  src: (await portraitLoader()).default,
  width: 600,
  format: "jpg",
  quality: 78,
});

// QR codes générés au build (SVG inline) : scannables depuis un PDF imprimé,
// en complément des liens cliquables.
const qrOptions = {
  type: "svg" as const,
  errorCorrectionLevel: "M" as const,
  margin: 0,
  color: { dark: "#0b0f19", light: "#ffffff" },
};
const siteQr = await QRCode.toString(cvBasics.personal.portfolioUrl, qrOptions);

interface PrimaryLink {
  url: string;
  label: string;
  icon: string;
}

function primaryLink(p: Project): PrimaryLink | null {
  const d = p.data;
  if (d.videoUrl) {
    const platform = /vimeo/i.test(d.videoUrl) ? "Vimeo" : "YouTube";
    return {
      url: d.videoUrl,
      label: `Voir le film (${platform})`,
      icon: "mdi:play-circle",
    };
  }
  if (d.liveUrl)
    return { url: d.liveUrl, label: "Voir en ligne", icon: "mdi:open-in-new" };
  if (d.figmaUrl)
    return {
      url: d.figmaUrl,
      label: "Explorer les maquettes",
      icon: "mdi:palette-swatch-outline",
    };
  if (d.repoUrl)
    return { url: d.repoUrl, label: "Code source", icon: "mdi:github" };
  return null;
}

const linkById = new Map(featured.map((p) => [p.id, primaryLink(p)]));
const qrSvgs = await limitConcurrency(featured, 2, async (p) => {
  const link = primaryLink(p);
  return QRCode.toString(link ? link.url : projectUrl(p), qrOptions);
});
const qrById = new Map(featured.map((p, i) => [p.id, qrSvgs[i]]));

function projectUrl(p: Project): string {
  return new URL(`project/${p.id}/`, config.url).href;
}

function pad2(n: number): string {
  return String(n).padStart(2, "0");
}

function chunk<T>(items: T[], size: number): T[][] {
  const out: T[][] = [];
  for (let i = 0; i < items.length; i += size)
    out.push(items.slice(i, i + size));
  return out;
}

// Pagination déterministe : chaque .sheet occupe exactement une page A4
// paysage, ce qui permet d'afficher de vrais numéros de page dans le sommaire.
// Chaque chapitre ouvre sur une page de titre puis enchaîne ses projets.
const othersChunks = chunk(others, 8);
const pageProfil = 2;
const pageSommaire = 3;
let pageCursor = pageSommaire;
let numberCursor = 0;
const sectionPages = sections.map((section) => {
  const dividerPage = ++pageCursor;
  const startPage = pageCursor + 1;
  pageCursor += section.entries.length;
  const numberOffset = numberCursor;
  numberCursor += section.entries.length;
  return { ...section, dividerPage, startPage, numberOffset };
});
const pageAutres = pageCursor + 1;
const pageParcours = pageAutres + othersChunks.length;
const pageContact = pageParcours + 1;
const totalPages = pageContact;

const sommaireSections = [
  { label: "Profil", page: pageProfil, anchor: "#profil" },
  ...sectionPages.map((section, i) => ({
    label: section.title,
    page: section.dividerPage,
    anchor: `#chapitre-${i + 1}`,
  })),
  { label: "Autres projets", page: pageAutres, anchor: "#autres-projets" },
  { label: "Parcours", page: pageParcours, anchor: "#parcours" },
  { label: "Contact", page: pageContact, anchor: "#contact" },
];

const personal = cvBasics.personal;
const pageTitle = "Portfolio PDF — Samuel Dulex";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <meta
      name="description"
      content="Version imprimable du portfolio de Samuel Dulex, destinée à l'export PDF."
    />
    <style is:inline>
      /* Polices locales du site (public/fonts), déclarées ici car cette page
         n'utilise pas le layout Base. */
      @font-face {
        font-family: "Space Grotesk";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/space-grotesk-bold.woff2") format("woff2");
      }

      @font-face {
        font-family: "Outfit";
        font-style: normal;
        font-weight: 300;
        font-display: swap;
        src: url("/fonts/outfit-light.woff2") format("woff2");
      }

      @font-face {
        font-family: "Outfit";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/outfit-regular.woff2") format("woff2");
      }

      @font-face {
        font-family: "Outfit";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/outfit-bold.woff2") format("woff2");
      }

      :root {
        /* Deux encres sur papier, comme la page de garde
           (design/garde-gsm-studios) : Electric Blue dominant, Safety Orange
           en accent. Les nuances sont des variations de densité de la même
           encre, jamais une troisième couleur. */
        --pdf-bg: #fafaf7;
        --pdf-panel: rgb(23 58 227 / 6%);
        --pdf-line: rgb(23 58 227 / 28%);
        --pdf-text: #173ae3;
        --pdf-muted: rgb(23 58 227 / 82%);
        --pdf-faint: rgb(23 58 227 / 52%);
        --pdf-ink: #173ae3;
        --pdf-accent: #e55d2b;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      @page {
        size: A4 landscape;
        margin: 0;
      }

      html {
        background: var(--pdf-bg);
      }

      body {
        background: var(--pdf-bg);
        color: var(--pdf-text);
        font-family: Outfit, sans-serif;
        font-weight: 300;
        font-size: 10pt;
        line-height: 1.45;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      /* ── Feuilles A4 paysage : une .sheet = une page PDF ── */
      .sheet {
        position: relative;
        width: 297mm;
        height: 210mm;
        padding: 14mm 16mm 16mm;
        overflow: hidden;
        break-after: page;
        break-inside: avoid;
        background: var(--pdf-bg);
      }

      .sheet:last-of-type {
        break-after: auto;
      }

      @media screen {
        body {
          background: #e2e8f0;
          padding: 8mm 0;
        }

        .sheet {
          margin: 0 auto 8mm;
          box-shadow: 0 2mm 8mm rgb(15 23 42 / 20%);
        }
      }

      /* ── Typographie commune ── */
      h1,
      h2,
      h3 {
        font-family: "Space Grotesk", sans-serif;
        font-weight: 700;
        text-wrap: balance;
      }

      h2 {
        font-size: 19pt;
        line-height: 1.12;
        letter-spacing: 0.01em;
        margin-bottom: 4mm;
      }

      /* Voix fonctionnelle : le mono porte les étiquettes et les données,
         Outfit porte ce qui se lit, Space Grotesk ce qui s'affiche. */
      .eyebrow {
        font-family: Menlo, monospace;
        font-weight: 400;
        font-size: 6.5pt;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--pdf-ink);
        margin-bottom: 3mm;
      }

      .section-label {
        font-family: Menlo, monospace;
        font-weight: 400;
        font-size: 6.5pt;
        text-transform: uppercase;
        letter-spacing: 0.26em;
        /* étiquette estompée, mais le filet reste à pleine densité */
        color: rgb(23 58 227 / 62%);
        border-top: 0.42mm solid var(--pdf-ink);
        padding-top: 2.4mm;
        margin: 5mm 0 2.6mm;
      }

      .muted {
        color: var(--pdf-muted);
      }

      .lead {
        font-size: 12pt;
        font-weight: 400;
        line-height: 1.55;
        margin-bottom: 3.5mm;
      }

      .accent-rule {
        width: 42mm;
        height: 1.2mm;
        /* deux encres bout à bout, pas un dégradé : arrêt net à 32 mm */
        background: linear-gradient(
          90deg,
          var(--pdf-ink) 0 32mm,
          var(--pdf-accent) 32mm
        );
        margin: 4mm 0;
      }

      .ico {
        width: 3.4mm;
        height: 3.4mm;
        flex: none;
        vertical-align: -0.5mm;
      }

      .chip {
        display: inline-block;
        font-family: Menlo, monospace;
        font-size: 6.5pt;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--pdf-muted);
      }

      .chip + .chip::before {
        content: "·";
        color: var(--pdf-accent);
        margin-right: 1.6mm;
      }

      .badge {
        display: inline-block;
        border-top: 0.42mm solid var(--pdf-accent);
        color: var(--pdf-ink);
        padding: 2mm 0 0;
        font-size: 8.5pt;
        font-weight: 400;
        margin: 3mm 0 1mm;
      }

      /* ── Mobilité Suisse → Canada ── */
      .cover-mobility {
        display: inline-flex;
        align-items: center;
        gap: 2mm;
        margin-top: 2mm;
        font-weight: 700;
      }

      .mobility-card {
        display: flex;
        align-items: flex-start;
        gap: 3.5mm;
        border-top: 0.42mm solid var(--pdf-ink);
        border-bottom: 0.42mm solid var(--pdf-ink);
        padding: 3.2mm 0;
        margin: 3.5mm 0 1mm;
      }

      .mobility-ico {
        width: 5.5mm;
        height: 5.5mm;
        flex: none;
        color: var(--pdf-accent);
        margin-top: 0.5mm;
      }

      .mobility-card div {
        display: flex;
        flex-direction: column;
        gap: 1mm;
      }

      .mobility-card strong {
        font-family: "Space Grotesk", sans-serif;
        font-size: 10.5pt;
        color: var(--pdf-ink);
      }

      .mobility-card span {
        font-size: 9.5pt;
        line-height: 1.45;
        color: var(--pdf-muted);
      }

      .hint {
        display: flex;
        align-items: center;
        gap: 1.6mm;
        margin-top: 4mm;
        font-size: 8pt;
        color: var(--pdf-faint);
      }

      .hint .ico {
        color: var(--pdf-ink);
      }

      .hint a {
        color: var(--pdf-ink);
      }

      /* ── Pied de page ── */
      .sheet-footer {
        position: absolute;
        left: 16mm;
        right: 16mm;
        bottom: 7mm;
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 4mm;
        font-size: 7pt;
        letter-spacing: 0.08em;
        color: var(--pdf-faint);
        border-top: 0.3mm solid var(--pdf-line);
        padding-top: 2mm;
      }

      .sheet-footer a {
        color: var(--pdf-ink);
      }

      .pageno {
        font-variant-numeric: tabular-nums;
      }

      /* ── QR codes ── */
      .qr-card {
        display: flex;
        align-items: center;
        gap: 3mm;
        background: #fff;
        color: var(--pdf-text);
        border: 0.3mm solid var(--pdf-line);
        padding: 3mm;
        width: fit-content;
      }

      .qr {
        display: block;
        width: 17mm;
        height: 17mm;
      }

      .qr svg {
        display: block;
        width: 100%;
        height: 100%;
      }

      .qr-caption {
        font-size: 7pt;
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      /* ── Couverture : affiche deux encres, trois spécimens tramés.
         Maquette éditable et scripts de trame : design/garde-gsm-studios/.
         Les cotes ci-dessous sont en millimètres sur la page A4 paysage. ── */
      .cover {
        padding: 0;

        /* spécimen 01 — le lustre */
        --lustre-x: 22mm;
        --lustre-y: 5mm;
        --lustre-w: 66mm;
        --viseur-x: 27mm;
        --viseur-y: 8mm;
        --viseur-w: 56mm;
        --viseur-h: 33mm;
        --label1-x: 34mm;
        --label1-y: 54mm;

        /* spécimen 02 — le globe, répété en cascade */
        --globe-x: 152mm;
        --globe-y: 46mm;
        --globe-w: 34mm;
        --label2-x: 96mm;
        --label2-y: 57.5mm;

        /* spécimen 03 — la caméra */
        --camera-x: 4mm;
        --camera-y: 151mm;
        --camera-w: 60mm;
        --label3-x: 60mm;
        --label3-y: 182mm;

        /* déclaration */
        --lead-y: 80mm;
        --titre-y: 96.5mm;
        --titre-taille: 18.5mm;
      }

      .cover-spec {
        position: absolute;
      }

      .cover-spec img {
        width: 100%;
        display: block;
      }

      .cover-spec.spec-1 {
        left: var(--lustre-x);
        top: var(--lustre-y);
        width: var(--lustre-w);
      }

      .cover-spec.spec-2 {
        left: var(--globe-x);
        top: var(--globe-y);
        width: var(--globe-w);
      }

      .cover-spec.spec-3 {
        left: var(--camera-x);
        top: var(--camera-y);
        width: var(--camera-w);
      }

      /* Le globe se répète en diagonale : deux impressions supplémentaires,
         de plus en plus grandes, qui se chevauchent et passent sous le titre. */
      .cover-spec.spec-2::before,
      .cover-spec.spec-2::after {
        content: "";
        position: absolute;
        background: var(--cover-globe) center / contain no-repeat;
      }

      .cover-spec.spec-2::before {
        left: 16mm;
        top: -14mm;
        width: 24mm;
        height: 24mm;
      }

      .cover-spec.spec-2::after {
        left: -26mm;
        top: 18mm;
        width: 46mm;
        height: 46mm;
      }

      .cover-spec-label {
        position: absolute;
        font-family: Menlo, monospace;
        font-size: 6pt;
        letter-spacing: 0.2em;
        line-height: 1.8;
        text-transform: uppercase;
        color: var(--pdf-ink);
        white-space: nowrap;
      }

      .cover-spec-label .num {
        color: var(--pdf-accent);
      }

      /* seconde ligne d'une légende : alignée après le numéro */
      .cover-spec-label .l2 {
        display: block;
        padding-left: 8.4mm;
      }

      .cover-spec-label.label-1 {
        left: var(--label1-x);
        top: var(--label1-y);
      }

      .cover-spec-label.label-2 {
        left: var(--label2-x);
        top: var(--label2-y);
        width: 50mm;
        text-align: right;
      }

      .cover-spec-label.label-3 {
        left: var(--label3-x);
        top: var(--label3-y);
      }

      /* Repère de visée sur le lustre — l'unique geste manuel de la page */
      .cover-mark {
        position: absolute;
        left: var(--viseur-x);
        top: var(--viseur-y);
        width: var(--viseur-w);
        height: var(--viseur-h);
      }

      .cover-mark i {
        position: absolute;
        width: 5mm;
        height: 5mm;
        border: 0.55mm solid var(--pdf-ink);
      }

      .cover-mark i:nth-child(1) {
        left: 0;
        top: 0;
        border-right: 0;
        border-bottom: 0;
      }

      .cover-mark i:nth-child(2) {
        right: 0;
        top: 0;
        border-left: 0;
        border-bottom: 0;
      }

      .cover-mark i:nth-child(3) {
        left: 0;
        bottom: 0;
        border-right: 0;
        border-top: 0;
      }

      .cover-mark i:nth-child(4) {
        right: 0;
        bottom: 0;
        border-left: 0;
        border-top: 0;
      }

      .cover-lead {
        position: absolute;
        left: 14mm;
        top: var(--lead-y);
        font-size: 11pt;
        font-weight: 400;
        line-height: 1.5;
        color: var(--pdf-ink);
      }

      .cover-display {
        position: absolute;
        left: 13.4mm;
        top: var(--titre-y);
        font-family: "Space Grotesk", sans-serif;
        font-weight: 700;
        font-size: var(--titre-taille);
        line-height: 1.02;
        letter-spacing: 0.012em;
        text-transform: uppercase;
        color: var(--pdf-ink);
        white-space: nowrap;
        /* surimpression là où la déclaration croise les globes */
        mix-blend-mode: multiply;
      }

      .cover-display .point {
        color: var(--pdf-accent);
      }

      /* Colonne d'informations : blocs réglés, voix mono */
      .cover-col {
        position: absolute;
        left: 194mm;
        right: 14mm;
        top: 12mm;
        color: var(--pdf-ink);
        font-family: Menlo, monospace;
      }

      .cover-block {
        border-top: 0.42mm solid var(--pdf-ink);
        padding: 2.6mm 0 4.6mm;
      }

      .cover-block-first {
        border-top: none;
        padding-top: 0;
      }

      .cover-label.section-label {
        border-top: none;
        padding-top: 0;
        margin: 0 0 1.8mm;
      }

      .cover-value {
        font-size: 7pt;
        line-height: 1.75;
        letter-spacing: 0.05em;
      }

      /* Ce qui se lit passe en Outfit ; le mono reste aux coordonnées. */
      .cover-read {
        font-family: Outfit, sans-serif;
        font-size: 8.5pt;
        line-height: 1.55;
        letter-spacing: 0;
      }

      /* Les logiciels : donnée technique, donc mono et discrète */
      .cover-tools {
        font-size: 6pt;
        line-height: 1.7;
        letter-spacing: 0.08em;
        color: rgb(23 58 227 / 66%);
        margin-top: 2.2mm;
      }

      .cover-kicker {
        font-size: 6pt;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        margin-bottom: 2mm;
      }

      .cover-name {
        font-family: "Space Grotesk", sans-serif;
        font-weight: 700;
        font-size: 24pt;
        line-height: 1.02;
        text-transform: uppercase;
        letter-spacing: 0.005em;
        margin: 0.6mm 0 1.4mm;
      }

      .cover-col-foot {
        top: auto;
        bottom: 9mm;
      }

      .cover-col-foot .cover-block {
        padding: 2.2mm 0 2.6mm;
      }

      .cover-route {
        font-family: "Space Grotesk", sans-serif;
        font-weight: 700;
        font-size: 14pt;
        text-transform: uppercase;
        letter-spacing: 0.01em;
      }

      .cover-permis {
        margin-top: 1.6mm;
      }

      /* Destination entourée à la main, à l'encre d'accent */
      .circled {
        position: relative;
        display: inline-block;
        padding: 0 1.2mm;
        color: var(--pdf-accent);
      }

      .circled svg {
        position: absolute;
        inset: -2.8mm -2.4mm -3.2mm -2.6mm;
        width: calc(100% + 5mm);
        height: calc(100% + 6mm);
        overflow: visible;
      }

      .cover-contacts {
        display: flex;
        flex-direction: column;
        gap: 2.2mm;
        font-size: 9.5pt;
        font-weight: 400;
        color: var(--pdf-text);
      }

      .contact-item {
        display: inline-flex;
        align-items: center;
        gap: 1.8mm;
      }

      .contact-item .ico {
        color: var(--pdf-ink);
      }

      /* ── Profil ── */
      .profil-grid {
        display: grid;
        grid-template-columns: 62mm 1fr;
        gap: 12mm;
        height: 168mm;
      }

      .profil-photo {
        width: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        object-position: center 30%;
        margin-bottom: 5mm;
      }

      .profil-contacts {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 2.2mm;
        font-size: 9pt;
        font-weight: 400;
        margin-bottom: 5mm;
      }

      .profil-contacts li {
        display: flex;
        align-items: center;
        gap: 2mm;
      }

      .profil-contacts .ico {
        color: var(--pdf-ink);
      }

      .profil-contacts a {
        color: var(--pdf-text);
      }

      .profil-langues {
        display: flex;
        flex-wrap: wrap;
        gap: 1.6mm;
      }

      .profil-outils {
        display: flex;
        flex-wrap: wrap;
        gap: 1.6mm;
      }

      .profil-main > .muted {
        font-size: 10.5pt;
        line-height: 1.5;
      }

      .skills-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4mm;
      }

      .skill-card {
        border-top: 0.42mm solid var(--pdf-ink);
        padding: 2.6mm 0 0;
        display: flex;
        flex-direction: column;
        gap: 1.4mm;
      }

      .skill-card strong {
        font-family: "Space Grotesk", sans-serif;
        font-size: 10.5pt;
      }

      .skill-card span {
        font-size: 9.5pt;
        line-height: 1.45;
        color: var(--pdf-muted);
      }

      /* ── Sommaire ── */
      .sommaire-grid {
        display: grid;
        grid-template-columns: 88mm 1fr;
        gap: 12mm;
        height: 168mm;
      }

      .sommaire-side {
        display: flex;
        flex-direction: column;
        height: 100%;
      }

      .sommaire-side > .muted {
        font-size: 10.5pt;
      }

      .sommaire-sections {
        display: flex;
        flex-direction: column;
        justify-content: center;
        flex: 1;
        margin-top: 5mm;
      }

      .sommaire-row {
        display: flex;
        align-items: baseline;
        gap: 2.5mm;
        padding: 3.4mm 0;
        border-bottom: 0.3mm solid var(--pdf-line);
        font-size: 11pt;
        font-weight: 400;
      }

      .sommaire-label {
        font-family: "Space Grotesk", sans-serif;
        font-weight: 700;
      }

      .sommaire-dots {
        flex: 1;
        border-bottom: 0.3mm dotted var(--pdf-faint);
      }

      .sommaire-page {
        color: var(--pdf-ink);
        font-variant-numeric: tabular-nums;
      }

      .sommaire-projets {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 9mm;
      }

      .sommaire-group {
        display: flex;
        flex-direction: column;
        gap: 3mm;
      }

      .sommaire-group-title {
        display: flex;
        align-items: baseline;
        gap: 3mm;
        font-family: "Space Grotesk", sans-serif;
        font-weight: 700;
        font-size: 11pt;
      }

      .sommaire-group-num {
        font-family: Outfit, sans-serif;
        font-weight: 700;
        font-size: 7.5pt;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--pdf-ink);
      }

      .sommaire-group-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-auto-rows: 26mm;
        gap: 4mm;
      }

      .sommaire-card {
        display: flex;
        border-top: 0.42mm solid var(--pdf-ink);
        overflow: hidden;
      }

      .sommaire-card img {
        width: 26mm;
        height: 100%;
        object-fit: cover;
        flex: none;
      }

      .sommaire-card-body {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1mm;
        padding: 2.5mm 3mm;
        min-width: 0;
      }

      .sommaire-card-num {
        font-family: "Space Grotesk", sans-serif;
        font-weight: 700;
        font-size: 7.5pt;
        color: var(--pdf-ink);
        letter-spacing: 0.15em;
      }

      .sommaire-card-title {
        font-size: 8.5pt;
        font-weight: 700;
        line-height: 1.25;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .sommaire-card-page {
        font-size: 7.5pt;
        color: var(--pdf-faint);
        font-variant-numeric: tabular-nums;
      }

      /* ── Pages de chapitre ── */
      .chapitre-numero {
        position: absolute;
        top: 6mm;
        right: 10mm;
        font-family: "Space Grotesk", sans-serif;
        font-weight: 700;
        font-size: 130pt;
        line-height: 1;
        color: rgb(229 93 43 / 18%);
      }

      .chapitre-center {
        position: relative;
        height: 168mm;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .chapitre-center h2 {
        font-size: 30pt;
        max-width: 220mm;
      }

      .chapitre-desc {
        font-size: 11.5pt;
        max-width: 168mm;
        margin-bottom: 8mm;
      }

      .chapitre-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        max-width: 190mm;
      }

      .chapitre-list a {
        display: flex;
        align-items: baseline;
        gap: 4mm;
        padding: 3.2mm 0;
        border-bottom: 0.3mm solid var(--pdf-line);
      }

      .chapitre-list-num {
        font-family: Menlo, monospace;
        font-weight: 400;
        font-size: 8pt;
        letter-spacing: 0.1em;
        color: var(--pdf-accent);
      }

      .chapitre-list-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.8mm;
        min-width: 0;
      }

      .chapitre-list-title {
        font-weight: 700;
        font-size: 10.5pt;
      }

      .chapitre-list-role {
        font-size: 8.5pt;
        color: var(--pdf-muted);
      }

      .chapitre-list-page {
        color: var(--pdf-faint);
        font-size: 9pt;
        font-variant-numeric: tabular-nums;
      }

      /* ── Projets phares ── */
      .projet {
        padding-right: 0;
      }

      .projet-text {
        width: 148mm;
        height: 168mm;
        display: flex;
        flex-direction: column;
        padding-right: 10mm;
      }

      .projet-titre {
        font-size: 18pt;
        line-height: 1.12;
        margin-bottom: 3.5mm;
      }

      .projet-intro {
        font-size: 11pt;
        font-weight: 400;
        line-height: 1.5;
        margin-bottom: 3mm;
      }

      .projet-note {
        font-size: 9.5pt;
        color: var(--pdf-muted);
        margin-bottom: 4mm;
      }

      .projet-faits {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 2.8mm 5mm;
        border-top: 0.42mm solid var(--pdf-ink);
        border-bottom: 0.42mm solid var(--pdf-ink);
        padding: 3.2mm 0;
        margin-bottom: 4.5mm;
      }

      .projet-faits dt {
        font-family: Menlo, monospace;
        font-size: 6pt;
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: 0.26em;
        color: rgb(23 58 227 / 62%);
        margin-bottom: 0.8mm;
      }

      .projet-faits dd {
        font-size: 9pt;
        font-weight: 400;
        line-height: 1.35;
      }

      .awards {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 1.8mm;
        margin-bottom: 4mm;
      }

      .awards li {
        display: flex;
        align-items: baseline;
        gap: 2mm;
        font-size: 9pt;
        font-weight: 400;
      }

      .awards .ico {
        color: var(--pdf-accent);
      }

      .metrics {
        display: flex;
        flex-wrap: wrap;
        gap: 3mm;
        margin-bottom: 4mm;
      }

      .metric {
        border-top: 0.42mm solid var(--pdf-ink);
        padding: 2mm 0 0;
        display: flex;
        flex-direction: column;
        gap: 0.5mm;
        max-width: 42mm;
      }

      .metric strong {
        font-family: "Space Grotesk", sans-serif;
        font-size: 12pt;
        color: var(--pdf-accent);
      }

      .metric span {
        font-family: Menlo, monospace;
        font-size: 6pt;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--pdf-muted);
        line-height: 1.3;
      }

      .projet-skills {
        display: flex;
        flex-wrap: wrap;
        gap: 1.6mm;
        margin-bottom: 4mm;
      }

      .projet-links {
        margin-top: 5mm;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 2.5mm;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 2mm;
        background: var(--pdf-ink);
        color: #fff;
        font-weight: 700;
        font-size: 9.5pt;
        padding: 2.4mm 5mm;
      }

      .case-link {
        font-size: 8pt;
        color: var(--pdf-ink);
      }

      .projet-media {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        width: 128mm;
        border-left: 0.8mm solid var(--pdf-text);
      }

      .projet-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .projet-media img.focus-left {
        object-position: left center;
      }

      .projet-media img.focus-right {
        object-position: right center;
      }

      .projet-media img.focus-top {
        object-position: center top;
      }

      /* Captures d'interface : montrées entières sur fond doux, jamais coupées. */
      .projet-media.media-contain {
        background: #eef0f6;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 9mm 9mm 24mm;
      }

      .projet-media.media-contain img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 1.5mm 3mm rgb(15 23 42 / 22%));
      }

      /* Visuels à fond blanc : zone média blanche, sans cadre ni ombre, pour que
         la capture se fonde dans la page au lieu de flotter dans un rectangle. */
      .projet-media.media-plain {
        background: #fff;
      }

      .projet-media.media-plain img {
        filter: none;
      }

      .qr-projet {
        position: absolute;
        right: 8mm;
        bottom: 14mm;
      }

      .projet .sheet-footer {
        right: 136mm;
      }

      /* ── Autres projets ── */
      .autres-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-auto-rows: 1fr;
        gap: 4mm;
        height: 148mm;
        margin-top: 2mm;
      }

      .autre-card {
        display: flex;
        flex-direction: column;
        border-top: 0.42mm solid var(--pdf-ink);
        overflow: hidden;
      }

      .autre-card img {
        width: 100%;
        height: 38mm;
        object-fit: cover;
        flex: none;
      }

      .autre-body {
        display: flex;
        flex-direction: column;
        gap: 1.2mm;
        padding: 3mm 3.5mm;
        min-height: 0;
      }

      .autre-title {
        font-family: "Space Grotesk", sans-serif;
        font-weight: 700;
        font-size: 8.5pt;
        line-height: 1.25;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .autre-role {
        font-size: 7.5pt;
        color: var(--pdf-muted);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .autre-meta {
        margin-top: auto;
        display: flex;
        align-items: center;
        gap: 1.6mm;
        font-size: 7pt;
        color: var(--pdf-faint);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding-top: 1.5mm;
      }

      .autre-meta .ico {
        color: var(--pdf-accent);
        width: 3mm;
        height: 3mm;
      }

      .autre-cta {
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: 2.5mm;
        padding: 5mm;
      }

      .autre-cta-ico {
        color: var(--pdf-accent);
        width: 7mm;
        height: 7mm;
        color: var(--pdf-ink);
      }

      .autre-cta .autre-role {
        color: var(--pdf-ink);
      }

      /* ── Parcours ── */
      .parcours-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12mm;
      }

      .timeline {
        list-style: none;
        display: flex;
        flex-direction: column;
      }

      .timeline li {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 4mm;
        padding: 3mm 0;
        border-bottom: 0.3mm solid var(--pdf-line);
      }

      .timeline-role {
        display: flex;
        flex-direction: column;
        gap: 0.6mm;
        min-width: 0;
      }

      .timeline-role strong {
        font-size: 10.5pt;
        font-weight: 700;
      }

      .timeline-company {
        font-size: 9pt;
        color: var(--pdf-ink);
      }

      .timeline-period {
        font-size: 8.5pt;
        color: var(--pdf-faint);
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }

      .distinctions {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 2.2mm;
        font-size: 9.5pt;
        color: var(--pdf-muted);
      }

      .parcours-langues {
        display: flex;
        flex-wrap: wrap;
        gap: 1.6mm;
        margin-top: 4mm;
      }

      .distinctions li {
        display: flex;
        align-items: baseline;
        gap: 2mm;
      }

      .distinctions .ico {
        color: var(--pdf-accent);
        width: 3mm;
        height: 3mm;
      }

      .distinctions strong {
        color: var(--pdf-text);
      }

      /* ── Contact ── */
      .contact-center {
        height: 168mm;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
      }

      .contact-center h2 {
        font-size: 32pt;
        text-transform: uppercase;
      }

      .contact-center .accent-rule {
        margin: 5mm auto;
      }

      .contact-center .badge {
        margin-top: 8mm;
      }

      .contact-email {
        font-family: "Space Grotesk", sans-serif;
        font-weight: 700;
        font-size: 17pt;
        color: var(--pdf-ink);
        margin-bottom: 4mm;
      }

      .contact-lines {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 3mm 8mm;
        font-size: 10pt;
        font-weight: 400;
        margin-bottom: 8mm;
      }

      .contact-lines a,
      .contact-lines span {
        display: inline-flex;
        align-items: center;
        gap: 1.8mm;
      }

      .contact-lines .ico {
        color: var(--pdf-ink);
      }

      .qr-contact {
        text-align: left;
      }

      .qr-contact .qr {
        width: 24mm;
        height: 24mm;
      }

      .qr-contact .qr-caption {
        text-transform: none;
        letter-spacing: 0.02em;
        font-weight: 400;
        max-width: 52mm;
      }
    </style>
  </head>
  <body>
    <!-- ═══════════ 1. Couverture ═══════════ -->
    <section class="sheet cover" aria-label="Couverture">
      {
        coverSpecimens.map((spec, i) => (
          <Fragment>
            <figure
              class={`cover-spec spec-${i + 1}`}
              style={`--cover-globe: url(${spec.src})`}
            >
              <img src={spec.src} alt="" />
            </figure>
            <p class={`cover-spec-label label-${i + 1}`}>
              <span class="num">{pad2(i + 1)}</span> · {spec.label}
              <span class="l2">{spec.source}</span>
            </p>
          </Fragment>
        ))
      }
      <figure class="cover-mark" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
        <i></i>
      </figure>

      <p class="cover-lead">
        {
          pdfConfig.cover.lead.map((line, i) => (
            <Fragment>
              {i > 0 && <br />}
              {line}
            </Fragment>
          ))
        }
      </p>
      <h1 class="cover-display">
        {
          pdfConfig.cover.display.map((line, i) => (
            <Fragment>
              {i > 0 && <br />}
              {line}
              <span class="point">.</span>
            </Fragment>
          ))
        }
      </h1>

      <aside class="cover-col">
        <div class="cover-block cover-block-first">
          <p class="cover-kicker">Portfolio · {pdfConfig.edition}</p>
          <p class="cover-name">{personal.name}</p>
        </div>
        <div class="cover-block">
          <p class="cover-value">
            <a href={sanitizeUrl(`mailto:${personal.email}`)}>
              {personal.email}
            </a>
            <br />
            <a href={sanitizeUrl(personal.portfolioUrl)}>
              {personal.portfolio}
            </a>
            {" · "}
            <a href={sanitizeUrl(personal.linkedinUrl)}>{personal.linkedin}</a>
          </p>
        </div>
        <div class="cover-block">
          <p class="section-label cover-label">Savoir-faire</p>
          <p class="cover-value cover-read">
            {
              pdfConfig.cover.savoirFaire.map((line, i) => (
                <Fragment>
                  {i > 0 && <br />}
                  {line}
                </Fragment>
              ))
            }
          </p>
          <p class="cover-value cover-tools">
            {
              pdfConfig.cover.logiciels.map((line, i) => (
                <Fragment>
                  {i > 0 && <br />}
                  {line}
                </Fragment>
              ))
            }
          </p>
        </div>
      </aside>

      <aside class="cover-col cover-col-foot">
        <div class="cover-block">
          <p class="cover-value cover-route">
            {pdfConfig.cover.route.from} →{" "}
            <span class="circled">
              {pdfConfig.cover.route.to}
              <svg viewBox="0 0 120 44" preserveAspectRatio="none" fill="none">
                <path
                  d="M8 24 C 6 10, 38 3, 66 4 C 96 5, 117 10, 116 21 C 115 34, 88 41, 55 40 C 28 39, 9 35, 10 26"
                  stroke="currentColor"
                  stroke-width="2.6"
                  stroke-linecap="round"></path>
              </svg>
            </span>
          </p>
          <p class="cover-value cover-permis">{pdfConfig.mobility.short}</p>
        </div>
      </aside>
    </section>

    <!-- ═══════════ 2. Profil ═══════════ -->
    <section class="sheet" id="profil" aria-label="Profil">
      <div class="profil-grid">
        <div class="profil-side">
          <img
            class="profil-photo"
            src={authorPhoto.src}
            alt={`Portrait de ${author.data.displayName}`}
          />
          <ul class="profil-contacts">
            <li>
              <Icon name="mdi:map-marker" class="ico" aria-hidden="true" />
              {personal.location}
            </li>
            <li>
              <Icon name="mdi:email" class="ico" aria-hidden="true" />
              <a href={sanitizeUrl(`mailto:${personal.email}`)}>
                {personal.email}
              </a>
            </li>
            <li>
              <Icon name="mdi:web" class="ico" aria-hidden="true" />
              <a href={sanitizeUrl(personal.portfolioUrl)}>
                {personal.portfolio}
              </a>
            </li>
            <li>
              <Icon name="mdi:linkedin" class="ico" aria-hidden="true" />
              <a href={sanitizeUrl(personal.linkedinUrl)}>
                {personal.linkedin}
              </a>
            </li>
          </ul>
          <div class="profil-langues">
            {
              cvBasics.languages.map((lang) => (
                <span class="chip">
                  <strong>{lang.name}</strong> — {lang.level}
                </span>
              ))
            }
          </div>
          <h3 class="section-label">Outils</h3>
          <div class="profil-outils">
            {pdfConfig.tools.map((tool) => <span class="chip">{tool}</span>)}
          </div>
        </div>
        <div class="profil-main">
          <p class="eyebrow">Profil</p>
          <h2>{personal.title}</h2>
          <p class="lead">{author.data.bio}</p>
          <p class="muted">{cvBasics.profile.content}</p>
          <div class="mobility-card">
            <Icon
              name="mdi:airplane-takeoff"
              class="mobility-ico"
              aria-hidden="true"
            />
            <div>
              <strong>{pdfConfig.mobility.title}</strong>
              <span>{pdfConfig.mobility.note}</span>
            </div>
          </div>
          <h3 class="section-label">{cvBasics.skills.title}</h3>
          <div class="skills-grid">
            {
              cvBasics.skills.items.map((skill) => (
                <div class="skill-card">
                  <strong>{skill.category}</strong>
                  <span>{skill.description}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
      <footer class="sheet-footer">
        <span>{personal.name} — Portfolio</span>
        <a href={sanitizeUrl(personal.portfolioUrl)}>{personal.portfolio}</a>
        <span class="pageno">{pad2(pageProfil)} / {pad2(totalPages)}</span>
      </footer>
    </section>

    <!-- ═══════════ 3. Sommaire ═══════════ -->
    <section class="sheet" id="sommaire" aria-label="Sommaire">
      <div class="sommaire-grid">
        <div class="sommaire-side">
          <p class="eyebrow">Navigation</p>
          <h2>Sommaire</h2>
          <p class="muted">{pdfConfig.intro}</p>
          <nav class="sommaire-sections" aria-label="Sections du document">
            {
              sommaireSections.map((section) => (
                <a class="sommaire-row" href={section.anchor}>
                  <span class="sommaire-label">{section.label}</span>
                  <span class="sommaire-dots" />
                  <span class="sommaire-page">p. {pad2(section.page)}</span>
                </a>
              ))
            }
          </nav>
          <p class="hint">
            <Icon
              name="mdi:cursor-default-click"
              class="ico"
              aria-hidden="true"
            />
            Sommaire, vignettes et liens sont cliquables dans ce PDF.
          </p>
        </div>
        <nav class="sommaire-projets" aria-label="Projets par chapitre">
          {
            sectionPages.map((section, sIdx) => (
              <div class="sommaire-group">
                <a class="sommaire-group-title" href={`#chapitre-${sIdx + 1}`}>
                  <span class="sommaire-group-num">
                    Chapitre {pad2(sIdx + 1)}
                  </span>
                  {section.title}
                </a>
                <div class="sommaire-group-grid">
                  {section.entries.map((p, i) => {
                    const thumb = thumbById.get(p.id);
                    return (
                      <a class="sommaire-card" href={`#projet-${p.id}`}>
                        {thumb && <img src={thumb.src} alt="" />}
                        <span class="sommaire-card-body">
                          <span class="sommaire-card-num">
                            {pad2(section.numberOffset + i + 1)}
                          </span>
                          <span class="sommaire-card-title">
                            {p.data.title}
                          </span>
                          <span class="sommaire-card-page">
                            p. {pad2(section.startPage + i)}
                          </span>
                        </span>
                      </a>
                    );
                  })}
                </div>
              </div>
            ))
          }
        </nav>
      </div>
      <footer class="sheet-footer">
        <span>{personal.name} — Portfolio</span>
        <a href={sanitizeUrl(personal.portfolioUrl)}>{personal.portfolio}</a>
        <span class="pageno">{pad2(pageSommaire)} / {pad2(totalPages)}</span>
      </footer>
    </section>

    <!-- ═══════════ 4+. Chapitres : page de titre puis projets ═══════════ -->
    {
      sectionPages.map((section, sIdx) => (
        <Fragment>
          <section
            class="sheet chapitre"
            id={`chapitre-${sIdx + 1}`}
            aria-label={section.title}
          >
            <span class="chapitre-numero" aria-hidden="true">
              {pad2(sIdx + 1)}
            </span>
            <div class="chapitre-center">
              <p class="eyebrow">Chapitre {pad2(sIdx + 1)}</p>
              <h2>{section.title}</h2>
              <div class="accent-rule" />
              <p class="muted chapitre-desc">{section.description}</p>
              <ul class="chapitre-list">
                {section.entries.map((p, i) => (
                  <li>
                    <a href={`#projet-${p.id}`}>
                      <span class="chapitre-list-num">
                        {pad2(section.numberOffset + i + 1)}
                      </span>
                      <span class="chapitre-list-main">
                        <span class="chapitre-list-title">{p.data.title}</span>
                        <span class="chapitre-list-role">
                          {p.data.role} · {p.data.pubDate.getFullYear()}
                        </span>
                      </span>
                      <span class="chapitre-list-page">
                        p. {pad2(section.startPage + i)}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <footer class="sheet-footer">
              <span>{personal.name} — Portfolio</span>
              <a href={sanitizeUrl(personal.portfolioUrl)}>
                {personal.portfolio}
              </a>
              <span class="pageno">
                {pad2(section.dividerPage)} / {pad2(totalPages)}
              </span>
            </footer>
          </section>
          {section.entries.map((p, i) => {
            const link = linkById.get(p.id) ?? null;
            const cover = coverById.get(p.id);
            const qr = qrById.get(p.id);
            const focus = imageFocus[p.id];
            return (
              <section
                class="sheet projet"
                id={`projet-${p.id}`}
                aria-label={p.data.title}
              >
                <div class="projet-text">
                  <p class="eyebrow">
                    {section.title} · {pad2(section.numberOffset + i + 1)}/
                    {pad2(featured.length)}
                  </p>
                  <h3 class="projet-titre">{p.data.title}</h3>
                  <p class="projet-intro">{p.data.intro}</p>
                  {noteById.get(p.id) && (
                    <p class="projet-note">{noteById.get(p.id)}</p>
                  )}
                  <dl class="projet-faits">
                    <div>
                      <dt>Rôle</dt>
                      <dd>{p.data.role}</dd>
                    </div>
                    <div>
                      <dt>Client</dt>
                      <dd>{p.data.client ?? "Projet personnel"}</dd>
                    </div>
                    <div>
                      <dt>Année</dt>
                      <dd>{p.data.pubDate.getFullYear()}</dd>
                    </div>
                    <div>
                      <dt>Format</dt>
                      <dd>{p.data.tag}</dd>
                    </div>
                  </dl>
                  {p.data.awards.length > 0 && (
                    <ul class="awards">
                      {p.data.awards.slice(0, 3).map((award) => (
                        <li>
                          <Icon
                            name="mdi:trophy"
                            class="ico"
                            aria-hidden="true"
                          />
                          {award}
                        </li>
                      ))}
                    </ul>
                  )}
                  {p.data.metrics.length > 0 && (
                    <div class="metrics">
                      {p.data.metrics.slice(0, 4).map((metric) => (
                        <div class="metric">
                          <strong>{metric.value}</strong>
                          <span>{metric.label}</span>
                        </div>
                      ))}
                    </div>
                  )}
                  {p.data.skills.length > 0 && (
                    <div class="projet-skills">
                      {p.data.skills.slice(0, 6).map((skill) => (
                        <span class="chip">{skill}</span>
                      ))}
                    </div>
                  )}
                  <div class="projet-links">
                    {link && (
                      <a class="btn" href={sanitizeUrl(link.url)}>
                        <Icon name={link.icon} class="ico" aria-hidden="true" />
                        {link.label}
                      </a>
                    )}
                    <a class="case-link" href={sanitizeUrl(projectUrl(p))}>
                      Étude de cas complète : portfolio.kuasar.xyz/project/
                      {p.id}/
                    </a>
                  </div>
                </div>
                <div
                  class:list={[
                    "projet-media",
                    (focus === "contain" || focus === "plain") &&
                      "media-contain",
                    focus === "plain" && "media-plain",
                  ]}
                >
                  {cover && (
                    <img
                      src={cover.src}
                      alt=""
                      class:list={[
                        focus &&
                          focus !== "contain" &&
                          focus !== "plain" &&
                          `focus-${focus}`,
                      ]}
                    />
                  )}
                  <a
                    class="qr-card qr-projet"
                    href={sanitizeUrl(link ? link.url : projectUrl(p))}
                    aria-label={link?.label ?? "Voir le projet"}
                  >
                    <span class="qr" set:html={qr} />
                    <span class="qr-caption">
                      Scanner
                      <br />
                      pour voir
                    </span>
                  </a>
                </div>
                <footer class="sheet-footer">
                  <span>{personal.name} — Portfolio</span>
                  <a href={sanitizeUrl(personal.portfolioUrl)}>
                    {personal.portfolio}
                  </a>
                  <span class="pageno">
                    {pad2(section.startPage + i)} / {pad2(totalPages)}
                  </span>
                </footer>
              </section>
            );
          })}
        </Fragment>
      ))
    }

    <!-- ═══════════ Autres projets ═══════════ -->
    {
      othersChunks.map((chunkProjects, chunkIndex) => (
        <section
          class="sheet"
          id={
            chunkIndex === 0
              ? "autres-projets"
              : `autres-projets-${chunkIndex + 1}`
          }
          aria-label="Autres projets"
        >
          <p class="eyebrow">Sélection complémentaire</p>
          <h2>
            Autres projets
            {othersChunks.length > 1 &&
              ` (${chunkIndex + 1}/${othersChunks.length})`}
          </h2>
          <div class="autres-grid">
            {chunkProjects.map((p) => {
              const thumb = otherThumbById.get(p.id);
              return (
                <a class="autre-card" href={sanitizeUrl(projectUrl(p))}>
                  {thumb && <img src={thumb.src} alt="" />}
                  <span class="autre-body">
                    <span class="autre-title">{p.data.title}</span>
                    <span class="autre-role">{p.data.role}</span>
                    <span class="autre-meta">
                      {p.data.pubDate.getFullYear()} · {p.data.tag}
                      {p.data.videoUrl && (
                        <Icon
                          name="mdi:play-circle"
                          class="ico"
                          aria-hidden="true"
                        />
                      )}
                    </span>
                  </span>
                </a>
              );
            })}
            {chunkIndex === othersChunks.length - 1 &&
              chunkProjects.length < 8 && (
                <a
                  class="autre-card autre-cta"
                  href={sanitizeUrl(new URL("project/", config.url).href)}
                >
                  <Icon
                    name="mdi:arrow-right"
                    class="autre-cta-ico"
                    aria-hidden="true"
                  />
                  <span class="autre-title">
                    Tous les projets, films et galeries
                  </span>
                  <span class="autre-role">portfolio.kuasar.xyz/project/</span>
                </a>
              )}
          </div>
          <footer class="sheet-footer">
            <span>{personal.name} — Portfolio</span>
            <a href={sanitizeUrl(personal.portfolioUrl)}>
              {personal.portfolio}
            </a>
            <span class="pageno">
              {pad2(pageAutres + chunkIndex)} / {pad2(totalPages)}
            </span>
          </footer>
        </section>
      ))
    }

    <!-- ═══════════ Parcours ═══════════ -->
    <section class="sheet" id="parcours" aria-label="Parcours">
      <p class="eyebrow">Curriculum</p>
      <h2>Parcours</h2>
      <div class="parcours-grid">
        <div>
          <h3 class="section-label">Expériences</h3>
          <ul class="timeline">
            {
              experiences.map((exp) => (
                <li>
                  <span class="timeline-role">
                    <strong>{exp.data.role}</strong>
                    <span class="timeline-company">{exp.data.company}</span>
                  </span>
                  <span class="timeline-period">{exp.data.period}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="section-label">Formation</h3>
          <ul class="timeline">
            {
              educations.map((edu) => (
                <li>
                  <span class="timeline-role">
                    <strong>{edu.data.degree}</strong>
                    <span class="timeline-company">{edu.data.school}</span>
                  </span>
                  <span class="timeline-period">{edu.data.period}</span>
                </li>
              ))
            }
          </ul>
          <h3 class="section-label">{cvBasics.awards.title}</h3>
          <ul class="distinctions">
            {
              cvBasics.awards.items.map((award) => (
                <li>
                  <Icon name="mdi:trophy" class="ico" aria-hidden="true" />
                  <span set:html={award} />
                </li>
              ))
            }
          </ul>
          <div class="parcours-langues">
            {
              cvBasics.languages.map((lang) => (
                <span class="chip">
                  <strong>{lang.name}</strong> — {lang.level}
                </span>
              ))
            }
          </div>
          <p class="hint">
            CV complet et version anglaise :
            <a href={sanitizeUrl(new URL("cv/", config.url).href)}>
              portfolio.kuasar.xyz/cv/
            </a>
          </p>
        </div>
      </div>
      <footer class="sheet-footer">
        <span>{personal.name} — Portfolio</span>
        <a href={sanitizeUrl(personal.portfolioUrl)}>{personal.portfolio}</a>
        <span class="pageno">{pad2(pageParcours)} / {pad2(totalPages)}</span>
      </footer>
    </section>

    <!-- ═══════════ Contact ═══════════ -->
    <section class="sheet contact" id="contact" aria-label="Contact">
      <div class="contact-center">
        <p class="eyebrow">Contact</p>
        <h2>Travaillons ensemble</h2>
        <div class="accent-rule"></div>
        <a class="contact-email" href={sanitizeUrl(`mailto:${personal.email}`)}>
          {personal.email}
        </a>
        <div class="contact-lines">
          <a href={sanitizeUrl(personal.portfolioUrl)}>
            <Icon name="mdi:web" class="ico" aria-hidden="true" />
            {personal.portfolio}
          </a>
          <a href={sanitizeUrl(personal.linkedinUrl)}>
            <Icon name="mdi:linkedin" class="ico" aria-hidden="true" />
            {personal.linkedin}
          </a>
          <span>
            <Icon name="mdi:map-marker" class="ico" aria-hidden="true" />
            {personal.location}
          </span>
        </div>
        <a
          class="qr-card qr-contact"
          href={sanitizeUrl(personal.portfolioUrl)}
          aria-label="Version interactive du portfolio"
        >
          <span class="qr" set:html={siteQr} />
          <span class="qr-caption">
            Études de cas, films et galeries :<br />la version interactive de ce
            portfolio
          </span>
        </a>
        <p class="badge">{personal.badge}</p>
      </div>
      <footer class="sheet-footer">
        <span>{personal.name} — Portfolio</span>
        <a href={sanitizeUrl(personal.portfolioUrl)}>{personal.portfolio}</a>
        <span class="pageno">{pad2(pageContact)} / {pad2(totalPages)}</span>
      </footer>
    </section>
    <!--
      Le CSS du site est bundlé en une seule feuille (vite cssCodeSplit:false)
      injectée dans le <head> de TOUTES les pages, donc après le style de
      cette page. Son bloc `@media print` impose A4 portrait et masque tous
      les <footer> — ce qui casserait l'export. On réaffirme donc ici, en fin
      de <body> pour passer en dernier, les seules règles qu'il écrase.
      Ce style reste `is:inline` : hors bundle, il ne fuit pas vers le site.
    -->
    <style is:inline>
      @page {
        size: A4 landscape;
        margin: 0;
      }

      @media print {
        body {
          color: var(--pdf-text) !important;
          background-color: var(--pdf-bg) !important;
        }

        /* Le site masque tous les <footer> à l'impression. */
        .sheet-footer {
          display: flex !important;
          opacity: 1 !important;
          visibility: visible !important;
        }

        /* Le site force `p,h1,h2,h3{color:#000!important}` : on rétablit
           l'encre du dossier, puis ses deux densités plus claires. */
        .sheet p,
        .sheet h1,
        .sheet h2,
        .sheet h3 {
          color: var(--pdf-text) !important;
        }

        .sheet .muted {
          color: var(--pdf-muted) !important;
        }

        .sheet .section-label {
          color: rgb(23 58 227 / 62%) !important;
        }

        .sheet .cover-tools {
          color: rgb(23 58 227 / 66%) !important;
        }
      }
    </style>
  </body>
</html>
